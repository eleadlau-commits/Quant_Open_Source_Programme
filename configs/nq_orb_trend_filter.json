{
  "name": "Nasdaq futures opening range breakout, 15-min EMA50/200 trend filter",
  "data": {"plugin": "synthetic_futures", "params": {"symbol": "MNQ", "n_days": 500, "seed": 11, "orb_momentum": 0.0}},
  "instrument": {"symbol": "MNQ", "tick_size": 0.25, "point_value": 2.0, "capital": 10000},
  "strategy": {
    "plugin": "opening_range_breakout",
    "params": {
      "symbol": "MNQ",
      "contracts": 1,
      "box_start": "09:30",
      "box_end": "09:45",
      "signal_minutes": 5,
      "stop_at": "box_height",
      "risk_r": 1.0,
      "target_r": 3.0,
      "last_entry": "15:30",
      "flat_time": "16:00",
      "trend_filter": true,
      "trend_timeframe": 15,
      "ema_fast": 50,
      "ema_slow": 200,
      "filtered_breakout": "skip_day",
      "direction_feature": "breakout",
      "exit": {"plugin": "never"}
    }
  },
  "costs": {"commission_per_side": 0.85, "slippage_ticks": 1, "stop_slippage_ticks": 1, "target_slippage_ticks": 0},
  "sweep": {
    "strategy.params.box_end": ["09:35", "09:45", "10:00"],
    "strategy.params.target_r": [2.0, 3.0, 4.0],
    "strategy.params.trend_timeframe": [5, 15, 30],
    "strategy.params.ema_fast": [20, 50],
    "strategy.params.ema_slow": [100, 200]
  },
  "evaluators": [
    {"plugin": "ablation", "params": {"path": "strategy.params.trend_filter", "value": false, "label": "trend filter"}},
    {"plugin": "out_of_sample", "params": {"split": 0.6}},
    {"plugin": "bootstrap", "params": {"block": 10}},
    {"plugin": "deflated_sharpe"},
    {"plugin": "cost_stress", "params": {"multiplier": 2}},
    {"plugin": "random_baseline", "params": {"n": 40, "rank_path": "strategy.params.direction_feature"}},
    {"plugin": "parameter_stability"}
  ]
}
